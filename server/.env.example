NODE_ENV=development
PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
DATABASE_URL=postgresql://magiccrm_owner:magiccrm_owner@localhost:54329/magiccrm
MIGRATION_DATABASE_URL=postgresql://magiccrm_owner:magiccrm_owner@localhost:54329/magiccrm
LESSON_COMPLETION_WORKER_ENABLED=true
LESSON_COMPLETION_WORKER_POLL_MS=15000
PLATFORM_OUTBOX_WORKER_ENABLED=true
INSTALLMENT_DUE_WORKER_ENABLED=true
LESSON_REMINDERS_ENABLED=false
TASK_REMINDERS_ENABLED=false
SCHEDULE_SERIES_AUTOEXTEND=true
JWT_ACCESS_SECRET=change-this-to-a-long-random-secret-before-production
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

FILE_STORAGE_ROOT=storage

RESEND_API_KEY=
RESEND_FROM_EMAIL=
SMTP_FALLBACK_HOST=
SMTP_FALLBACK_PORT=465
SMTP_FALLBACK_SECURE=true
SMTP_FALLBACK_USER=
SMTP_FALLBACK_PASSWORD=
SMTP_FALLBACK_FROM_EMAIL=

FIREBASE_SERVER_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_TIMEOUT_MS=5000
NOTIFICATION_TOKEN_ENCRYPTION_KEY=
V4_ACCESS_MODE=shadow
V4_ACCESS_KILL_SWITCH=false
V4_SCHEDULE_MODE=shadow
V4_SCHEDULE_KILL_SWITCH=false
V4_PARITY_UNEXPLAINED_DIFFS=1
# Production is fail-closed: both modes must be v4, both kill switches false,
# and V4_PARITY_UNEXPLAINED_DIFFS=0. Shadow/legacy are development or staging only.
LEAD_WEBHOOK_SECRET=

HOLLIHOP_BASE_URL=https://sokol.t8s.ru/Api/V2/
HOLLIHOP_AUTH_KEY=
HOLLIHOP_TIMEOUT_MS=5000
HOLLIHOP_IMPORT_MODE=dry_run
HOLLIHOP_IMPORT_TAKE=500
HOLLIHOP_IMPORT_STORE_SOURCE_RECORDS=true
HOLLIHOP_IMPORT_VALIDATE_ONLY=false
