{
  "name": "magic-music-crm-server",
  "version": "0.1.0",
  "private": true,
  "description": "MagicMusicCRM v3 owned backend API.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "db:migrate": "ts-node src/db/migrate.ts up",
    "db:migrate:prod": "node dist/db/migrate.js up",
    "db:rollback": "ts-node src/db/migrate.ts down",
    "db:rollback:prod": "node dist/db/migrate.js down",
    "supabase:export": "ts-node src/migration/supabase-export.ts",
    "supabase:export:prod": "node dist/migration/supabase-export.js",
    "migration:import": "ts-node src/migration/v3-import.ts",
    "migration:import:prod": "node dist/migration/v3-import.js",
    "hollihop:import": "ts-node src/migration/hollihop-import.ts",
    "hollihop:import:prod": "node dist/migration/hollihop-import.js",
    "storage:import": "ts-node src/migration/storage-import.ts",
    "storage:import:prod": "node dist/migration/storage-import.js",
    "security:gate": "ts-node src/security/security-gate.ts",
    "smoke:realtime": "ts-node src/smoke/realtime-smoke.ts",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.26",
    "@nestjs/websockets": "^11.1.26",
    "@sentry/node": "^10.60.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "google-auth-library": "^10.7.0",
    "joi": "^18.2.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "jest": "^30.0.5",
    "socket.io-client": "^4.8.3",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "js-yaml": "^4.2.0",
    "ws": "^8.21.0"
  }
}
