{
  "name": "magic-music-crm-server",
  "version": "0.1.0",
  "private": true,
  "description": "MagicMusicCRM v3 owned backend API.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "db:migrate": "ts-node src/db/migrate.ts up",
    "db:migrate:prod": "node dist/db/migrate.js up",
    "db:rollback": "ts-node src/db/migrate.ts down",
    "hollihop:import-exports": "ts-node src/migration/import-hollihop-exports.ts",
    "hollihop:import": "ts-node src/migration/hollihop-import.ts",
    "hollihop:link-leads": "ts-node src/migration/link-students-to-leads.ts",
    "db:rollback:prod": "node dist/db/migrate.js down",
    "security:gate": "ts-node src/security/security-gate.ts",
    "v4:backfill": "ts-node src/platform/v4-backfill.ts",
    "v4:migrate:dry-run": "ts-node src/platform/v4-migrate-dry-run.ts",
    "v4:preflight": "ts-node src/platform/v4-preflight.ts",
    "v4:reconcile": "ts-node src/platform/v4-reconcile.ts",
    "v7:backfill": "ts-node src/platform/v7-commerce-data.ts --apply",
    "v7:reconcile": "ts-node src/platform/v7-commerce-data.ts",
    "v4:shadow-compare": "ts-node src/platform/v4-shadow-compare.ts",
    "v4:access-coverage": "ts-node src/access-control/v4-access-coverage.ts",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:actor-matrix:v4": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --runTestsByPath src/access-control/actor-matrix-postgres.integration.spec.ts src/access-control/actor-matrix-payload-leak.spec.ts",
    "test:schedule-v4": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --runTestsByPath src/crm/schedule/availability.spec.ts src/crm/schedule/constraint-engine.spec.ts src/crm/schedule/availability-postgres.integration.spec.ts src/crm/schedule/constraint-engine-postgres.integration.spec.ts src/crm/schedule/lesson-write-parity.integration.spec.ts src/crm/schedule/lesson-series-postgres.integration.spec.ts src/crm/schedule/reschedule-postgres.integration.spec.ts src/crm/schedule/completion-worker-postgres.integration.spec.ts src/crm/schedule/no-attendance-mutations.contract.spec.ts",
    "test:commerce-v4": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --runTestsByPath src/crm/commerce/commerce-schema-postgres.integration.spec.ts src/crm/commerce/package-catalog.integration.spec.ts src/crm/commerce/subscription-issue-postgres.integration.spec.ts src/crm/commerce/subscription-replace-postgres.integration.spec.ts src/crm/commerce/subscription-cancel-postgres.integration.spec.ts src/crm/commerce/subscription-lesson-race-postgres.integration.spec.ts src/crm/commerce/lesson-settlement-postgres.integration.spec.ts src/crm/commerce/commerce-projections.contract.spec.ts",
    "test:tasks-v4": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --runTestsByPath src/crm/tasks/shared-task-migration-postgres.integration.spec.ts src/crm/tasks/shared-task-postgres.integration.spec.ts src/crm/tasks/task-reminders.integration.spec.ts",
    "test:export-v4": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --runTestsByPath src/analytics/ooxml-export.integration.spec.ts",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.1.26",
    "@nestjs/websockets": "^11.1.26",
    "@sentry/node": "^10.60.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "exceljs": "4.4.0",
    "google-auth-library": "^10.7.0",
    "joi": "^18.2.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "jest": "^30.0.5",
    "socket.io-client": "^4.8.3",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "js-yaml": "^5.2.3",
    "uuid": "^11.1.1",
    "ws": "^8.21.0"
  }
}
