# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
/dist/
/server/node_modules/
/server/dist/
/server/coverage/
/server/.env
# Любые производные от .env — бэкапы, .local, .prod. Правило `/server/.env`
# матчит только точное имя, поэтому `server/.env.bak-123` спокойно попадал в
# `git status` со всеми секретами внутри.
/server/.env.*
!/server/.env.example
/server/.migration.env
/server/exports/
/server/storage/
/infra/staging/.env
/infra/staging/.backup.env
/infra/staging/.monitor.env
/infra/staging/.deploy.env
/.flutter.env
/exports/
/security-scans/
/.supergoal/
/.worktrees/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/key.properties
/android/*.jks
/android/*.keystore

# Local service state
/supabase/.temp/
/release-site/.vercel/

# Generated local analysis/capture artifacts
/s8_*.png
/server/db/backups/
/.repowise/
/.mcp.json
/.codex/config.toml
/.codex/hooks.json
/.vscode/mcp.json
/.impeccable/
/_archive/
/installer_output/
/outputs/stage9-release-*/
/dist/release211/
/ast_nodes*.json
/bugreport-*.zip
/docs/Supabase_Custom_Domain_Setup_Guide.docx
/docs/release/play_console/screenshots/raw/

# Temporary Microsoft Office owner/lock files.
~$*.docx
~*.tmp
/outputs/~*.tmp

# Local scratch evidence that has already been copied into the canonical audit tree.
/.tmp/

# HolliHop data dumps (real client PII — never commit)
hollihop-dump/
/server/hollihop-dump/
