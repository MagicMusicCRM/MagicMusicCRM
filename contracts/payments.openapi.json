  "info": {
    "title": "MagicMusicCRM payment record commands",
    "description": "Create, transition, correct and reverse payment records. Subscription and account adjustment commands are not covered.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ActualPaymentResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "studentId": {
            "type": "string",
            "format": "uuid"
          },
          "issuedSubscriptionId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "amountMinor": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "currencyCode": {
            "type": "string"
          },
          "method": {
            "type": "string",
            "enum": [
              "cash",
              "cashless"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "branchId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "branchName": {
            "type": "string",
            "nullable": true
          },
          "comment": {
            "type": "string",
            "nullable": true
          },
          "invoiceIdentifier": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "paid"
            ]
          },
          "acceptedBy": {
            "$ref": "#/components/schemas/PaymentActorDto"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "studentId",
          "issuedSubscriptionId",
          "amountMinor",
          "currencyCode",
          "method",
          "occurredAt",
          "branchId",
          "branchName",
          "comment",
          "invoiceIdentifier",
          "status",
          "acceptedBy",
          "version",
          "createdAt"
        ]
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "statusCode",
          "code",
          "message",
          "timestamp",
          "path"
        ]
      },
      "CorrectPaymentDto": {
        "type": "object",
        "properties": {
          "previewToken": {
            "type": "string",
            "maxLength": 16384
          },
          "confirm": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "previewToken",
          "confirm",
          "reason"
        ],
        "additionalProperties": false
      },
      "CreatePaymentRecordDto": {
        "type": "object",
        "properties": {
          "lessonId": {
            "type": "string",
            "format": "uuid"
          },
          "issuedSubscriptionId": {
            "type": "string",
            "format": "uuid"
          },
          "installmentId": {
            "type": "string",
            "format": "uuid"
          },
          "amountMinor": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$",
            "maxLength": 12,
            "description": "Integer minor units encoded as a decimal string."
          },
          "currencyCode": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "unpaid",
              "posted_pending",
              "paid"
            ]
          },
          "dueAt": {
            "type": "string",
            "description": "ISO 8601 due date."
          },
          "method": {
            "type": "string",
            "enum": [
              "cash",
              "cashless"
            ],
            "description": "Required when status is paid."
          },
          "externalIdentifier": {
            "type": "string",
            "maxLength": 120,
            "description": "Receipt or transaction identifier; required when paid."
          },
          "occurredAt": {
            "type": "string",
            "description": "ISO 8601 receipt date; required when paid."
          },
          "branchId": {
            "type": "string",
            "format": "uuid",
            "description": "Must match the student branch."
          },
          "verificationNote": {
            "type": "string",
            "maxLength": 1000
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "amountMinor",
          "status",
          "reason"
        ],
        "additionalProperties": false
      },
      "PaymentActorDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
