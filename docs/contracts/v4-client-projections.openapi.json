        "properties": {
          "id": {
            "type": "string"
          },
          "scheduledAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "safe_homework": {
        "type": "object",
        "required": ["id", "title", "status"],
        "properties": {
