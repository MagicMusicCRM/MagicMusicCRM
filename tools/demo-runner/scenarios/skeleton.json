{
  "version": "t9.3-login-skeleton-v1",
  "steps": [
    {
      "id": "login.client",
      "role": "client",
      "description": "Авторизация клиента на AVD Client",
      "action": {
        "type": "login",
        "successLocator": {
          "using": "android uiautomator",
          "value": "new UiSelector().descriptionContains(\"Абонемент\")"
        }
      },
      "reconcile": [
        {
          "type": "visible",
          "locator": {
            "using": "android uiautomator",
            "value": "new UiSelector().descriptionContains(\"Абонемент\")"
          }
        }
      ],
      "assert": [
        { "type": "currentPackage", "value": "magic.crm" }
      ]
    },
    {
