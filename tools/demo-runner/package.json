{
  "name": "@magicmusiccrm/demo-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic four-AVD demo orchestrator for MagicMusicCRM",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "demo": "node src/cli.mjs",
    "demo:full": "node src/cli.mjs --scenario scenarios/full-demo.json",
    "dry-run": "node src/cli.mjs --dry-run",
    "dry-run:full": "node src/cli.mjs --dry-run --scenario scenarios/full-demo.json",
    "test": "node --test",
    "appium": "appium --address 127.0.0.1 --port 4723 --log-level error",
    "doctor": "node src/doctor.mjs"
  },
  "devDependencies": {
    "appium": "3.5.2",
    "appium-uiautomator2-driver": "8.1.0",
    "webdriverio": "9.29.1"
  }
}
