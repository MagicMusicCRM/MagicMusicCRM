API_DOMAIN=api.magicmusiccrm.ru
ACME_EMAIL=admin@magicmusiccrm.ru

POSTGRES_DB=magiccrm
POSTGRES_OWNER_USER=magiccrm_owner
POSTGRES_OWNER_PASSWORD=replace-with-openssl-rand-hex-24
POSTGRES_APP_USER=magiccrm_app
POSTGRES_APP_PASSWORD=replace-with-openssl-rand-hex-24

CORS_ALLOWED_ORIGINS=https://magic-music.org,http://localhost:3000
JWT_ACCESS_SECRET=replace-with-openssl-rand-base64-48
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.magicmusiccrm.ru/auth/google/callback

RESEND_API_KEY=
RESEND_FROM_EMAIL=
SMTP_FALLBACK_HOST=
SMTP_FALLBACK_PORT=465
SMTP_FALLBACK_SECURE=true
SMTP_FALLBACK_USER=
SMTP_FALLBACK_PASSWORD=
SMTP_FALLBACK_FROM_EMAIL=

FIREBASE_SERVER_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_TIMEOUT_MS=5000
NOTIFICATION_TOKEN_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

HOLLIHOP_BASE_URL=https://sokol.t8s.ru/Api/V2/
HOLLIHOP_AUTH_KEY=
HOLLIHOP_TIMEOUT_MS=5000

# Backend error tracking (KVA-225). Leave empty to disable. Loaded into the
# api container via env_file; set to the backend Sentry project DSN.
SENTRY_DSN=
SENTRY_RELEASE=
