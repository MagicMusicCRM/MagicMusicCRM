HEALTH_URL=https://api.magicmusiccrm.ru/api/health/ready
STACK_DIR=/opt/magicmusiccrm/infra/staging
ENV_FILE=/opt/magicmusiccrm/infra/staging/.env
ALERT_LOG=/opt/magicmusiccrm/monitoring/alerts.log
BACKEND_ERROR_LOG=/opt/magicmusiccrm/monitoring/backend-errors.log
STATE_FILE=/opt/magicmusiccrm/monitoring/current-failure.sha256
RECENT_LOG_SECONDS=75
DISK_PATH=/opt/magicmusiccrm
DISK_MAX_PERCENT=85
REQUIRED_SERVICES=api,caddy,postgres,redis
FORCE_MONITOR_FAIL=0

# Leave dry-run enabled until a real alert sink is configured.
ALERT_DRY_RUN=1

# Optional Telegram alert sink. Do not commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
